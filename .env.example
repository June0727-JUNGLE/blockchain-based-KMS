# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is listed in `.gitignore`.

# Arbitrum Sepolia JSON-RPC endpoint (Alchemy, Infura, or public RPC)
ARBITRUM_SEPOLIA_URL=https://sepolia-rollup.arbitrum.io/rpc

# Deployer / admin wallet private key (0x prefix optional)
# Use a dedicated test wallet with Sepolia ETH only — not your mainnet wallet.
PRIVATE_KEY=your_private_key_here

# Off-chain KMS server (localhost demo)
KMS_RPC_URL=http://127.0.0.1:8545
KMS_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
STORAGE_MASTER_KEY=dev-storage-master-key-change-in-production
KMS_SERVER_PORT=4000
